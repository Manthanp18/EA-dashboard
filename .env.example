# Server Configuration
PORT=8000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/mt5_dashboard

# Dashboard Authentication
DASHBOARD_PASSWORD=changeme123

# Rate Limiting (requests per minute)
# RATE_LIMIT_PUSH should be: (number of accounts × 12) + 20% buffer
# For 20 accounts: 20 × 12 = 240, so use 300
RATE_LIMIT_PUSH=300
RATE_LIMIT_STATE=120
